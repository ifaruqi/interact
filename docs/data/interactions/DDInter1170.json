":""},"DDInter900":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter905":{"severity":"Moderate","severitySource":"DDInter","mechanism":"Coadministration of idelalisib with other agents known to induce hepatotoxicity may potentiate the risk of liver injury. The use of idelalisib has been associated with elevations in alanine aminotransferase (ALT) and aspartate aminotransferase (AST) greater than 5 times the upper limit of normal.","mechanismSource":"MecDDI"},"DDInter916":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter953":{"severity":"Moderate","severitySource":"DDInter","mechanism":"INTERVAL: Certain drugs may affect the pharmacokinetics, pharmacodynamics, and/or diagnostic results of radioiodides.","mechanismSource":"MecDDI"},"DDInter954":{"severity":"Moderate","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter98":{"severity":"Moderate","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter990":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1174":{"severity":"Moderate","severitySource":"DDInter","mechanism":"Coadministration of methotrexate with other agents known to induce hepatotoxicity may potentiate the risk of liver injury. Methotrexate, especially at higher doses or with prolonged treatment, has been associated with hepatotoxicity including acute hepatitis, chronic fibrosis, necrosis, cirrhosis, and liver enzyme elevations.","mechanismSource":"MecDDI"},"DDInter1199":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1200":{"severity":"Moderate","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1242":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1244":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1247":{"severity":"Unknown","