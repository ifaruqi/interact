{"DDInter1197":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter12":{"severity":"Moderate","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1202":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1228":{"severity":"Major","severitySource":"DDInter","mechanism":"Coadministration of mipomersen with other agents known to induce hepatotoxicity may potentiate the risk of liver injury. Mipomersen can cause elevations in serum transaminases and hepatic steatosis.","mechanismSource":"MecDDI"},"DDInter126":{"severity":"Moderate","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1266":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter133":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1363":{"severity":"Moderate","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1365":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1409":{"severity":"Moderate","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1417":{"severity":"Moderate","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1435":{"severity":"Major","severitySource":"DDInter","mechanism":"Serious cases of hepatotoxicity, some fatal, have occurred in patients treated with pexidartinib. Concomitant use of other potentially hepatotoxic agents may potentiate the risk of liver injury. The mechanism of hepatotoxicity is unknown, its occurrence cannot be predicted, and it is unknown whether liver injury occurs in the absence of increased transaminases.","mechanismSource":"MecDDI"},"DDInter1442":{"severity":"Minor","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1471":{"severity":"Moderate","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1513":{"severity":"Moderate","severitySource":"DDInter","mechanism":"The clearance of prednisolone may be increased when coadministered with some antithyroid agents, such as carbimazole and methimazole. The mechanism for this interaction has not been delineated, but may involve induction of CYP450-mediated metabolism of prednisolone.","mechanismSource":"MecDDI"},"DDInter1538":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1553":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1559":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1568":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1578":{"severity":"Moderate","severitySource":"DDInter","mechanism":"Concomitant use of remdesivir with other agents that are known to induce hepatotoxicity may theoretically increase the risk of liver injury. Data from investigational use and clinical studies suggest that remdesivir may be associated with hepatotoxic effects.","mechanismSource":"MecDDI"},"DDInter1587":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1604":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1622":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1632":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1662":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter170":{"severity":"Moderate","severitySource":"DDInter","mechanism":"Coadministration of bedaquiline with other agents known to induce hepatotoxicity may potentiate the risk of liver injury.","mechanismSource":"MecDDI"},"DDInter1771":{"severity":"Major","severitySource":"DDInter","mechanism":"The recent, concomitant, or subsequent use (without the recommended leflunomide washout period or procedure) of other agents known to induce hepatotoxicity may potentiate the risk of liver injury associated with leflunomide. The risk is thought to extend to teriflunomide, its principal active metabolite, because recommended dosages of both result in a similar range of plasma concentrations of teriflunomide.","mechanismSource":"MecDDI"},"DDInter1799":{"severity":"Moderate","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1815":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1832":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1840":{"severity":"Moderate","severitySource":"DDInter","mechanism":"Coadministration of trabectedin with other agents known to induce hepatotoxicity may potentiate the risk of liver injury.","mechanismSource":"MecDDI"},"DDInter1906":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1919":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter20":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter228":{"severity":"Moderate","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter246":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter252":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter264":{"severity":"Moderate","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter284":{"severity":"Moderate","severitySource":"DDInter","mechanism":"Coadministration of cannabidiol with other agents known to induce hepatotoxicity may potentiate the risk of liver injury. Cannabidiol causes dose-related elevations of liver transaminases, both alanine aminotransferase (ALT) and aspartate aminotransferase (AST).","mechanismSource":"MecDDI"},"DDInter292":{"severity":"Unknown","severitySource":"DDIn