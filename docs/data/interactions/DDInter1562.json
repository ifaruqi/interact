{"DDInter1568":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1593":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1622":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1632":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1635":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1647":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1663":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1675":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1678":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1725":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1735":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1744":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1754":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1768":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1783":{"severity":"Unknown","severitySource":"DDInter","mechanism":"","mechanismSource":""},"DDInter1789":{"severity":"Major","severitySource":"DDInter","mechanism":"Concomitant treatment with agents that can cause thrombosis such as erythropoiesis-stimulating agents, oestrogens, selective estrogen receptor modulators, or C1 esterase inhibitors may potentiate the risk of venous thromboembolic events associated with the use of thalidomide. When used in multiple myeloma, there is an increased risk of venous thromboembolism such as deep venous thrombosis and pulmonary embolism. This risk